{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": [
        "-m", "uvicorn", "main:app", "--reload",
        "--host", "127.0.0.1", "--port", "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run", "dev", "--prefix", "frontend", "--", "--host", "127.0.0.1"
      ],
      "port": 5173
    }
  ]
}
