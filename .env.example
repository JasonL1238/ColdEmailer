# === AI provider (pick one) ===
# Needed for company discovery, website research, and AI-written emails.
# Without a key the app still runs: emails fall back to plain templates.
# Provider is auto-detected from whichever key is set.

# Google Gemini — recommended, free tier available
GOOGLE_AI_API_KEY=

# Alternatives
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Force a provider or model instead of auto-detecting
# EMAIL_LLM_PROVIDER=gemini            # gemini | openrouter | openai
# EMAIL_LLM_MODEL=gemini-2.5-flash

# === Rate limits ===
MAX_EMAILS_PER_DAY=50
MAX_EMAIL_GENERATIONS_PER_DAY=500
MAX_EMAIL_GENERATIONS_PER_MINUTE=10
MAX_COMPANY_RESEARCH_PER_MINUTE=5
EMAIL_SEND_DELAY_SECONDS=3

# === Paths (defaults work for the standard project layout) ===
# COLD_DB_PATH=backend/data/coldemailer.db
# CREDENTIALS_JSON_PATH=credentials.json
# TOKEN_JSON_PATH=token.json

# Optional Hunter.io key (free tier) for person email finder
# HUNTER_API_KEY=
# Pattern guesses are notes-only (never auto-attached as verified email)
# EMAIL_PATTERN_INFERENCE=1

# === Other ===
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional GitHub token — raises the API ceiling from 60 to 5000 requests/hour.
# The person finder reads addresses from public commit headers either way; a
# token just means it can do it for more people per hour.
# GITHUB_TOKEN=

# SEC full-text search requires a declared contact address in the User-Agent
# (sec.gov 403s a browser UA). Falls back to your Settings profile email;
# without either, the EDGAR source is skipped rather than faking a contact.
# SEC_CONTACT_EMAIL=

# Mailbox verification (RCPT TO only — never sends mail). OFF by default: it
# opens connections to third-party mail servers from your IP, or sends the
# address to a verification provider. Most consumer ISPs block outbound port
# 25 outright — run scripts/probe_smtp_feasibility.py before enabling.
# MAILBOX_VERIFY=0
# SMTP_PROBE_HELO=mail.yourdomain.com   # must be an FQDN you control
# SMTP_PROBE_FROM=                      # only if a server rejects a null sender
