# Copy to .env and fill in. Backend reads from project root or backend/.env.

# --- Backend ---
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Paths (relative to project root or backend dir, depending on how you run the app)
CSV_FILE_PATH=data/contacts.csv
COMPANY_CACHE_PATH=data/company_cache.json
EMAIL_STORAGE_PATH=data/generated_emails.json
# Personal profile YAML (contains name/signature/default user fields)
PERSONAL_CONFIG_PATH=personal_profile.yaml

# Gmail OAuth: leave unset to use project_root/credentials.json and project_root/token.json
# CREDENTIALS_JSON_PATH=
# TOKEN_JSON_PATH=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Rate limits
MAX_EMAILS_PER_DAY=50
MAX_EMAIL_GENERATIONS_PER_MINUTE=10
MAX_COMPANY_RESEARCH_PER_MINUTE=5

# Email sending
EMAIL_SEND_DELAY_SECONDS=3
# RESUME_PATH=  # optional path to resume file for email sender

# Stress test mode (simulate slow/failing APIs)
# STRESS_TEST_MODE=false

# --- Frontend (Vite: only VITE_* are exposed in the client) ---
# Optional telemetry ingest URL. Leave unset to disable telemetry.
# VITE_TELEMETRY_URL=

# API base URL. Use /api for dev proxy; use full URL when backend is on another host.
# VITE_API_BASE_URL=/api
