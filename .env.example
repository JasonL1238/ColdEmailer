# Every runtime knob the backend reads, with the reason each exists. README
# links here rather than repeating them. Copy to .env and uncomment what you
# need; all of it is optional.

# === AI provider (pick one) ===
# Needed for company discovery, website research, and AI-written emails.
# Without a key the app still runs: emails fall back to plain templates.
# Provider is auto-detected from whichever key is set.

# Google Gemini — recommended, free tier available
GOOGLE_AI_API_KEY=

# Alternatives
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Force a provider or model instead of auto-detecting
# EMAIL_LLM_PROVIDER=gemini            # gemini | openrouter | openai
# EMAIL_LLM_MODEL=gemini-2.5-flash

# === Rate limits ===
MAX_EMAILS_PER_DAY=50
MAX_EMAIL_GENERATIONS_PER_DAY=500
MAX_EMAIL_GENERATIONS_PER_MINUTE=10
MAX_COMPANY_RESEARCH_PER_MINUTE=5
EMAIL_SEND_DELAY_SECONDS=3

# === Paths (defaults work for the standard project layout) ===
# COLD_DB_PATH=backend/data/coldemailer.db
# COLD_RESUME_DIR=backend/data/resumes
# CREDENTIALS_JSON_PATH=credentials.json
# TOKEN_JSON_PATH=token.json
# One-time profile seed, read only when Settings is still empty. The default
# resolves to the repo's own skills.md, which holds the original owner's bio —
# point this elsewhere if you are not them.
# SKILLS_FILE_PATH=skills.md

# Optional Hunter.io key for person email finder and mailbox-verifier fallback.
# Ten bounded name patterns use direct SMTP first; a definitive success does
# not spend Hunter credit, while blocked/catch-all SMTP falls back immediately.
# HUNTER_API_KEY=
# Pattern guesses are notes-only (never auto-attached as verified email)
# EMAIL_PATTERN_INFERENCE=1

# === Other ===
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Website used by the same one-time profile seed as SKILLS_FILE_PATH.
# PERSONAL_WEBSITE_URL=

# === Scheduled sending ===
# The sweep thread starts at boot but sends nothing until the Settings sending
# window is on and a batch was explicitly scheduled.
# COLD_SCHEDULER_TICK_SECONDS=60   # how often the sweep looks for due mail
# COLD_SCHEDULE_STALE_HOURS=72     # a message overdue by more than this is dropped
# COLD_DISABLE_SCHEDULER=1         # any value stops the thread; the test suite sets it

# Optional GitHub token — raises the API ceiling from 60 to 5000 requests/hour.
# The person finder reads addresses from public commit headers either way; a
# token just means it can do it for more people per hour.
# GITHUB_TOKEN=

# SEC full-text search requires a declared contact address in the User-Agent
# (sec.gov 403s a browser UA). Falls back to your Settings profile email;
# without either, the EDGAR source is skipped rather than faking a contact.
# SEC_CONTACT_EMAIL=

# Mailbox verification (RCPT TO only — never sends mail). OFF by default. It
# tries the recipient MX over port 25, then uses Hunter only when direct SMTP is
# unavailable or inconclusive. Run scripts/probe_smtp_feasibility.py first.
# MAILBOX_VERIFY=0
# SMTP_PROBE_HELO=mail.yourdomain.com   # must be an FQDN you control
# SMTP_PROBE_FROM=                      # only if a server rejects a null sender

# Address corroboration — asks free public corpora (GitHub commits and
# profiles, Gravatar, PGP keyservers, lore.kernel.org) whether a guessed
# address has ever actually been used, and by whom. ON by default, unlike
# MAILBOX_VERIFY: these are read-only lookups against public search endpoints,
# no mail server is contacted and no address list is handed to a vendor
# (Gravatar only ever sees a hash). Measured over 40 real and 12 invented
# addresses: zero false positives on every source. Set to 0 to disable.
# ADDRESS_CORROBORATION=1
