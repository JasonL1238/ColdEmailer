# === LLM Provider (pick one) ===
# Auto-detected by key presence, or set EMAIL_LLM_PROVIDER explicitly.
# EMAIL_LLM_PROVIDER=gemini            # gemini | openrouter | openai
# EMAIL_LLM_MODEL=gemini-2.0-flash     # override default model per provider

# Google Gemini (recommended — free tier available)
GOOGLE_AI_API_KEY=

# OpenRouter (Claude, Llama, etc.)
# OPENROUTER_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# === Ollama (local, used as fallback for follow-ups) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Rate Limits ===
MAX_EMAILS_PER_DAY=50
MAX_EMAIL_GENERATIONS_PER_DAY=500
MAX_EMAIL_GENERATIONS_PER_MINUTE=10
MAX_COMPANY_RESEARCH_PER_MINUTE=5
EMAIL_SEND_DELAY_SECONDS=3

# === Paths (defaults work for standard project layout) ===
# RESUME_PATH=resume28.pdf
# CSV_FILE_PATH=data/contacts.csv
# EMAIL_STORAGE_PATH=data/generated_emails.json
# COMPANY_CACHE_PATH=data/company_cache.json
# SKILLS_FILE_PATH=skills.md
# CREDENTIALS_JSON_PATH=credentials.json
# TOKEN_JSON_PATH=token.json

# === Other ===
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# PERSONAL_WEBSITE_URL=https://your-site.com
# RESUME_URL=https://your-site.com/resume.pdf
# STRESS_TEST_MODE=false
